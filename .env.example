# =============================================================================
# Student Attendance System - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to Git (it's in .gitignore)
# =============================================================================

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# MongoDB Connection String
# For local development: mongodb://localhost:27017/
# For MongoDB Atlas: mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/attendance_system?retryWrites=true&w=majority
# Make sure to include the database name: /attendance_system
MONGODB_URI=mongodb://localhost:27017/

# MongoDB Connection Timeout (milliseconds)
# Default: 5000 (5 seconds)
MONGODB_TIMEOUT=5000

# =============================================================================
# FLASK APPLICATION CONFIGURATION
# =============================================================================

# Flask Secret Key (REQUIRED for production)
# Generate a secure key: python -c "import secrets; print(secrets.token_hex(32))"
# Or use: https://randomkeygen.com/
# Minimum 32 characters recommended
SECRET_KEY=your-secret-key-here-generate-random-string-minimum-32-characters

# Flask Environment
# Options: development, production
# Default: development (for local), production (for Render)
FLASK_ENV=development

# Port Number (usually set automatically by hosting platform)
# Render sets PORT automatically, but you can override for local development
# Default: 5000
PORT=5000

# =============================================================================
# EMAIL CONFIGURATION (SMTP)
# =============================================================================

# SMTP Server Address
# Gmail: smtp.gmail.com
# Outlook: smtp-mail.outlook.com
# Custom: your-smtp-server.com
SMTP_SERVER=smtp.gmail.com

# SMTP Port
# Gmail: 587 (TLS) or 465 (SSL)
# Outlook: 587
# Default: 587
SMTP_PORT=587

# SMTP Username (Email Address)
# This is your email address used for sending emails
# Example: your_email@gmail.com
SMTP_USERNAME=your_email@gmail.com

# SMTP Password
# For Gmail: Use App Password (NOT your regular password)
# Steps to get Gmail App Password:
# 1. Enable 2-Factor Authentication on your Google account
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Generate App Password for "Mail"
# 4. Use the 16-character password here (no spaces)
# Example: abcd efgh ijkl mnop (use as: abcdefghijklmnop)
SMTP_PASSWORD=your_smtp_app_password_here

# From Email Address
# Usually same as SMTP_USERNAME
# This is the email address that will appear as sender
FROM_EMAIL=your_email@gmail.com

# From Name
# Display name for email sender
# Default: College Attendance System
FROM_NAME=College Attendance System

# Teacher Email Addresses (Comma-separated)
# These emails will receive daily attendance summary reports
# Separate multiple emails with commas (no spaces)
# Example: teacher1@example.com,teacher2@example.com,teacher3@example.com
TEACHER_EMAILS=teacher1@example.com,teacher2@example.com

# =============================================================================
# OPTIONAL CONFIGURATION
# =============================================================================

# Railway Environment (for Railway deployment)
# Set to any value to disable browser auto-open
# Leave empty for other platforms
RAILWAY_ENVIRONMENT=

# =============================================================================
# NOTES
# =============================================================================
# 
# 1. For Local Development:
#    - Copy this file to .env
#    - Fill in your local MongoDB URI (mongodb://localhost:27017/)
#    - Set up Gmail App Password for email
#    - Generate a SECRET_KEY
#
# 2. For Render.com Deployment:
#    - Go to Render Dashboard → Your Service → Environment
#    - Add each variable manually (do NOT upload .env file)
#    - Use MongoDB Atlas connection string for MONGODB_URI
#    - Render automatically sets PORT (don't override)
#
# 3. Security:
#    - NEVER commit .env file to Git
#    - Use strong SECRET_KEY in production
#    - Use App Passwords, not regular passwords
#    - Keep MONGODB_URI secure (contains credentials)
#
# 4. Testing Email:
#    - Test with a single email first
#    - Verify SMTP credentials are correct
#    - Check spam folder if emails don't arrive
#
# =============================================================================

